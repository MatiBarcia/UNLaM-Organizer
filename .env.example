# OAuth Client ID de Google Cloud Console (tipo "Web application").
# Ver el paso a paso en el README para crearlo. No es secreto — queda embebido
# en el bundle del frontend, la seguridad la da el scope drive.appdata acotado.
VITE_GOOGLE_CLIENT_ID=

# Access key de Web3Forms (https://web3forms.com) para el formulario "Informar error".
# Tampoco es secreto — queda embebido en el bundle del frontend; lo único que habilita
# es enviar mails a la casilla dueña de la key. Sin esta variable, el botón no se muestra.
VITE_WEB3FORMS_KEY=
